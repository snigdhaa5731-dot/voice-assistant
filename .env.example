# Voice Assistant Configuration

# Assistant Name
ASSISTANT_NAME=Aura

# Speech Configuration
TTS_RATE=175
TTS_VOLUME=1.0

# OpenWeatherMap API (Advanced Tier)
# Get a free API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
DEFAULT_CITY=New York

# Email / SMTP Configuration (Advanced Tier)
# Set to 'false' to connect to a real SMTP server. If 'true', emails are simulated safely.
MOCK_EMAIL=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test.assistant@example.com
SMTP_PASSWORD=your_app_password_here
DEFAULT_RECIPIENT=user@example.com
